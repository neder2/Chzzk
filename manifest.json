{
    "manifest_version":  3,
    "name":  "Better Chzzk",
    "version":  "1.1.7",
    "description":  "치지직 자동 화질, 다시보기 스킵/검색, 방송 목록 필터, 채널 방송 시간, 시청 기록, 안내 팝업 정리를 제공합니다.",
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "permissions":  [
                        "storage"
                    ],
    "host_permissions":  [
                             "https://api.chzzk.naver.com/*",
                             "https://apis.naver.com/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://chzzk.naver.com/*"
                                            ],
                                "js":  [
                                           "features/autoQualityPage.js",
                                           "features/volumeWheelPage.js"
                                       ],
                                "run_at":  "document_start",
                                "world":  "MAIN"
                            },
                            {
                                "matches":  [
                                                "https://chzzk.naver.com/*"
                                            ],
                                "js":  [
                                           "shared/settings.js",
                                           "shared/data.js",
                                           "content.js",
                                           "features/adblockPopup.js",
                                           "features/vodReplayChatFix.js",
                                           "features/autoQuality.js",
                                           "features/skipControl.js",
                                           "features/vodBroadcastClock.js",
                                           "features/timeMachineLagLabel.js",
                                           "features/monthlyBroadcastTime.js",
                                           "features/liveWatchHistory.js",
                                           "features/videoSearch.js",
                                           "features/categoryTools.js",
                                           "features/titleTooltip.js",
                                           "features/volumeWheel.js",
                                           "features/volumeTooltip.js",
                                           "features/followingRefresh.js",
                                           "features/shortcutRescue.js"
                                       ],
                                "run_at":  "document_start"
                            }
                        ],
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "features/autoQualityPage.js"
                                                       ],
                                         "matches":  [
                                                         "https://chzzk.naver.com/*"
                                                     ]
                                     }
                                 ],
    "action":  {
                   "default_title":  "Better Chzzk 설정",
                   "default_popup":  "options.html",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "options_page":  "options.html"
}
